    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "jsdom": "^24.0.0",
    "playwright": "^1.43.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
