{
  "name": "apex-fit-ai-alpha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:tests": "npx playwright install && npm install -D @testing-library/react @testing-library/jest-dom @testing-library/user-event vitest jsdom playwright",
    "test": "vitest",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "dev": "next dev -H 0.0.0.0",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "perf:analyze": "npm run build:analyze",
    "perf:lighthouse": "lhci autorun",
    "perf:build-stats": "npx next build --profile"
  },
