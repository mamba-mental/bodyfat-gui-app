"use client"

import * as React from "react"
import { Brain, TrendingUp, Target, Activity, Calendar, RefreshCcw } from "lucide-react"
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import { Button } from "@/components/ui/button"
import { Badge } from "@/components/ui/badge"
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs"
import { useApp } from "@/contexts/app-context"
import { AIInsightsPanel } from "@/components/ai/ai-insights-panel"
import ClientIcon from "@/components/ui/client-icon"
import { Progress } from "@/components/ui/progress"
import { useRouter } from "next/navigation"

export default function AIInsightsPage() {
  const { state } = useApp()
  const { current_user, current_calculation, entries } = state
  const router = useRouter()
  const [refreshing, setRefreshing] = React.useState(false)

  const handleRefreshInsights = async () => {
    setRefreshing(true)
    // Force refresh by clearing local cache
    localStorage.removeItem('ai_insights_cache')
    // Wait a bit to show the refresh is happening
    setTimeout(() => {
      setRefreshing(false)
      window.location.reload()
    }, 1000)
  }

  if (!current_user) {
    return (
      <div className="container max-w-4xl mx-auto space-y-6">
        <div className="text-center space-y-2">
          <h1 className="text-3xl font-bold tracking-tight">AI Insights</h1>
          <p className="text-muted-foreground">
            Get AI-powered insights and recommendations for your fitness journey
          </p>
        </div>
        
        <Card>
          <CardContent className="pt-6">
            <p className="text-center text-muted-foreground">
              Please complete your profile setup to receive personalized AI insights.
            </p>
          </CardContent>
        </Card>
      </div>
    )
  }

  const progressPercentage = entries.length > 0 && current_user
    ? Math.max(0, Math.min(100, ((current_user.current_weight - entries[0].weight) / (current_user.current_weight - current_user.goal_weight)) * 100))
    : 0

  return (
    <div className="container max-w-6xl mx-auto space-y-6">
      <div className="flex items-center justify-between">
        <div className="space-y-2">
          <h1 className="text-3xl font-bold tracking-tight">AI Insights</h1>
          <p className="text-muted-foreground">
            AI-powered analysis and recommendations for your fitness journey
          </p>
        </div>
        <div className="flex items-center gap-2">
          <Button 
            variant="outline" 
            onClick={handleRefreshInsights}
            disabled={refreshing}
          >
            <ClientIcon icon={RefreshCcw} className={`mr-2 h-4 w-4 ${refreshing ? 'animate-spin' : ''}`} />
            Refresh Insights
          </Button>
          <Badge variant="secondary" className="text-sm">
            Beta Feature
          </Badge>
        </div>
      </div>

      {/* Overview Cards */}
      <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm font-medium">Overall Progress</CardTitle>
            <ClientIcon icon={TrendingUp} className="h-4 w-4 text-muted-foreground" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{progressPercentage.toFixed(0)}%</div>
            <Progress value={progressPercentage} className="mt-2" />
            <p className="text-xs text-muted-foreground mt-1">
              Toward your goal weight
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm font-medium">Weekly Entries</CardTitle>
            <ClientIcon icon={Calendar} className="h-4 w-4 text-muted-foreground" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{entries.length}</div>
            <p className="text-xs text-muted-foreground">
              Consistency is key to success
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm font-medium">Current Phase</CardTitle>
            <ClientIcon icon={Target} className="h-4 w-4 text-muted-foreground" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">
              {entries.length <= 4 ? 'Initial' : entries.length <= 8 ? 'Adaptation' : 'Progress'}
            </div>
            <p className="text-xs text-muted-foreground">
              Week {entries.length} of your journey
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm font-medium">AI Confidence</CardTitle>
            <ClientIcon icon={Brain} className="h-4 w-4 text-muted-foreground" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">
              {current_calculation?.confidence_score || 'N/A'}%
            </div>
            <p className="text-xs text-muted-foreground">
              Plan reliability score
            </p>
          </CardContent>
        </Card>
      </div>

      {/* AI Insights Tabs */}
      <Tabs defaultValue="progress" className="space-y-4">
        <TabsList className="grid w-full grid-cols-4">
          <TabsTrigger value="progress">Progress Insights</TabsTrigger>
          <TabsTrigger value="nutrition">Nutrition Analysis</TabsTrigger>
          <TabsTrigger value="training">Training Tips</TabsTrigger>
          <TabsTrigger value="motivation">Motivation</TabsTrigger>
        </TabsList>

        <TabsContent value="progress" className="space-y-4">
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <ClientIcon icon={TrendingUp} className="h-5 w-5" />
                Progress Analysis
              </CardTitle>
              <CardDescription>
                AI-powered analysis of your weight loss journey
              </CardDescription>
            </CardHeader>
            <CardContent>
              <AIInsightsPanel categories={["progress"]} showHeader={false} />
            </CardContent>
          </Card>
        </TabsContent>

        <TabsContent value="nutrition" className="space-y-4">
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <ClientIcon icon={Activity} className="h-5 w-5" />
                Nutrition Recommendations
              </CardTitle>
              <CardDescription>
                Personalized nutrition guidance based on your goals
              </CardDescription>
            </CardHeader>
            <CardContent>
              <AIInsightsPanel categories={["nutrition"]} showHeader={false} />
            </CardContent>
          </Card>
        </TabsContent>

        <TabsContent value="training" className="space-y-4">
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <ClientIcon icon={Target} className="h-5 w-5" />
                Training Optimization
              </CardTitle>
              <CardDescription>
                Workout recommendations tailored to your profile
              </CardDescription>
            </CardHeader>
            <CardContent>
              <AIInsightsPanel categories={["workout"]} showHeader={false} />
            </CardContent>
          </Card>
        </TabsContent>

        <TabsContent value="motivation" className="space-y-4">
          <Card>
            <CardHeader>
              <CardTitle className="flex items-center gap-2">
                <ClientIcon icon={Brain} className="h-5 w-5" />
                Daily Motivation
              </CardTitle>
              <CardDescription>
                AI-generated motivation to keep you on track
              </CardDescription>
            </CardHeader>
            <CardContent>
              <AIInsightsPanel categories={["health"]} showHeader={false} />
            </CardContent>
          </Card>
        </TabsContent>
      </Tabs>

      {/* Additional Insights Section */}
      <div className="grid gap-4 md:grid-cols-2">
        <Card>
          <CardHeader>
            <CardTitle>Key Recommendations</CardTitle>
            <CardDescription>Based on your current progress</CardDescription>
          </CardHeader>
          <CardContent>
            <div className="space-y-4">
              {entries.length >= 2 ? (
                <>
                  <div className="flex items-start gap-2">
                    <div className="w-2 h-2 bg-primary rounded-full mt-1.5"></div>
                    <div>
                      <p className="font-medium">Calorie Adjustment</p>
                      <p className="text-sm text-muted-foreground">
                        {current_calculation?.progression?.[0]?.daily_calorie_intake 
                          ? `Maintain your current intake of ${Math.round(current_calculation.progression[0].daily_calorie_intake)} calories`
                          : 'Calculate your optimal calorie intake'}
                      </p>
                    </div>
                  </div>
                  <div className="flex items-start gap-2">
                    <div className="w-2 h-2 bg-primary rounded-full mt-1.5"></div>
                    <div>
                      <p className="font-medium">Activity Level</p>
                      <p className="text-sm text-muted-foreground">
                        {current_user.activity_level >= 3 
                          ? 'Your activity level is optimal for fat loss'
                          : 'Consider increasing your daily activity for better results'}
                      </p>
                    </div>
                  </div>
                  <div className="flex items-start gap-2">
                    <div className="w-2 h-2 bg-primary rounded-full mt-1.5"></div>
                    <div>
                      <p className="font-medium">Consistency</p>
                      <p className="text-sm text-muted-foreground">
                        {entries.length >= 4
                          ? 'Great job staying consistent with your tracking!'
                          : 'Keep logging entries weekly for best results'}
                      </p>
                    </div>
                  </div>
                </>
              ) : (
                <p className="text-muted-foreground">
                  Add more weekly entries to receive personalized recommendations
                </p>
              )}
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Next Steps</CardTitle>
            <CardDescription>Actions to optimize your progress</CardDescription>
          </CardHeader>
          <CardContent>
            <div className="space-y-4">
              <div className="flex items-center justify-between p-3 border rounded-lg">
                <div>
                  <p className="font-medium">Log Weekly Entry</p>
                  <p className="text-sm text-muted-foreground">Track your progress</p>
                </div>
                <Button size="sm" variant="outline" onClick={() => router.push('/entries/new')}>
                  Add Entry
                </Button>
              </div>
              <div className="flex items-center justify-between p-3 border rounded-lg">
                <div>
                  <p className="font-medium">Generate Report</p>
                  <p className="text-sm text-muted-foreground">View detailed analysis</p>
                </div>
                <Button size="sm" variant="outline" onClick={() => router.push('/reports')}>
                  View Reports
                </Button>
              </div>
              <div className="flex items-center justify-between p-3 border rounded-lg">
                <div>
                  <p className="font-medium">Configure AI</p>
                  <p className="text-sm text-muted-foreground">Optimize AI responses</p>
                </div>
                <Button size="sm" variant="outline" onClick={() => router.push('/settings/ai')}>
                  AI Settings
                </Button>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  )
}